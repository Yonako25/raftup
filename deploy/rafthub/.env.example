# Réglages du déploiement du Rafthub officiel.
# Copier ce fichier en `.env` (même dossier), puis remplir. Le fichier `.env` ne
# doit jamais être commité : il peut contenir des secrets.
# Aucune valeur ci-dessous n'est vraie : ce sont des exemples.

# --- Obligatoire -------------------------------------------------------------

# Nom de domaine du hub, sans https:// ni / final. Un enregistrement DNS A (et AAAA
# si l'IPv6 est utilisée) doit déjà pointer vers l'IP publique du serveur.
RAFTHUB_DOMAIN=hub.exemple.org

# Réseau Docker de Traefik (voir `docker network ls`), déjà créé par sa pile.
TRAEFIK_NETWORK=traefik

# Nom du « certresolver » déclaré dans la configuration de Traefik
# (certificatesResolvers.<nom>), par exemple celui de Let's Encrypt.
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Facultatif --------------------------------------------------------------

# Point d'entrée HTTPS de Traefik (entryPoints.<nom>), souvent `websecure`.
TRAEFIK_ENTRYPOINT=websecure

# Fuseau horaire des journaux et de l'heure de sauvegarde.
TZ=Europe/Paris

# Niveau des journaux : error, warn, info, debug.
RAFTHUB_LOG=info

# Sauvegarde de la base intégrée : heure (0 à 23), nombre de jours gardés, et
# dossier de l'hôte où écrire (relatif à ce dossier, ou chemin absolu).
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
RAFTHUB_BACKUP_DIR=./backups

# Base externe imposée (sinon : choix dans l'assistant /admin au premier lancement).
# Exemple : postgres://rafthub:MOT_DE_PASSE@postgres:5432/rafthub
RAFTUP_HUB_DB=

# Réglages aussi modifiables dans la console (/admin → Réglages), qui passe avant.
RAFTUP_HUB_NAME=
# open, invite ou closed
RAFTUP_HUB_REGISTRATION=
# true ou false
RAFTUP_HUB_PUBLIC_DOWNLOAD=
# smtps://utilisateur:MOT_DE_PASSE@smtp.exemple.org:465
RAFTUP_HUB_SMTP_URL=
# Raftup <no-reply@exemple.org>
RAFTUP_HUB_MAIL_FROM=
# Application Discord (portail développeur de Discord), version officielle seulement.
# Adresse de retour à déclarer chez Discord : https://<RAFTHUB_DOMAIN>/v1/oauth/discord/callback
RAFTUP_HUB_DISCORD_CLIENT_ID=
RAFTUP_HUB_DISCORD_CLIENT_SECRET=
