# Fins de ligne LF partout, y compris sous Windows (évite les différences parasites entre OS)
* text=auto eol=lf

# Scripts Windows : restent en CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fichiers binaires : jamais convertis
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff2 binary
*.archipelago binary
*.raftup binary
