# Compilation Rust
/target/

# Réglages locaux de Claude Code (propres à chaque poste)
.claude/settings.local.json
# Copies de travail isolées des agents (worktrees)
.claude/worktrees/

# Éditeurs et systèmes
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Seeds et sauvegardes de parties générées localement (peuvent contenir des mots de passe)
*.archipelago
*.raftup
!tests/fixtures/**/*.archipelago
!tests/fixtures/**/*.raftup
# Seeds de test des crates (générées pour les tests, sans mot de passe)
!crates/*/tests/data/*.archipelago
!crates/*/tests/data/*.raftup

# Python (scripts de test)
__pycache__/

# Registre : copies locales des paquets, index produit et rapport de CI (jamais commités, voir registre/README.md)
/registre/fichiers/
/registre/sortie/
/registre/rapport/

# Déploiement du Rafthub : secrets locaux et sauvegardes (deploy/rafthub/README.md)
/deploy/rafthub/.env
/deploy/rafthub/backups/

# Tests de l'interface (egui_kittest) : images du jour et différences, jamais commitées
# (seules les références `<nom>.png` le sont, voir crates/launcher-ui/tests/README.md)
*.new.png
*.diff.png
*.old.png
